{
  "name": "uemulator",
  "version": "0.1.0",
  "description": "One desktop library and launcher for mGBA, PyBoy, Project64, Azahar and Ryujinx.",
  "private": true,
  "main": "src/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:cores": "node scripts/build-cores.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.uemulator.app",
    "productName": "Uemulator",
    "files": [
      "src/**",
      "package.json",
      "!cores/**",
      "!bin/**"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "linux": {
      "category": "Game"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Uemulator",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
