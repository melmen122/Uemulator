{
  "name": "uemulator",
  "version": "0.1.0",
  "description": "One desktop library and launcher for mGBA, PyBoy, Project64, Azahar, Ryujinx, RPCS3 and Lichii.",
  "private": true,
  "main": "src/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:cores": "node scripts/build-cores.mjs",
    "dist": "electron-builder",
    "bundle:win": "node scripts/bundle-win.mjs",
    "dist:win": "npm run bundle:win && electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.uemulator.app",
    "productName": "Uemulator",
    "files": [
      "src/**",
      "package.json",
      "!cores/**",
      "!bin/**",
      "!bundle-win/**"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "linux": {
      "category": "Game"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "bundle-win/emulators",
          "to": "emulators",
          "filter": [
            "**/*",
            "!**/.uemulator-ps3fw.json",
            "!rpcs3/dev_bdvd/**",
            "!rpcs3/dev_flash/**",
            "!rpcs3/dev_flash2/**",
            "!rpcs3/dev_flash3/**",
            "!rpcs3/dev_hdd0/**",
            "!rpcs3/dev_hdd1/**",
            "!rpcs3/dev_usb000/**",
            "!rpcs3/log/**",
            "!rpcs3/*.log",
            "!rpcs3/*.buf",
            "!rpcs3/captures/**",
            "!rpcs3/shaderlog/**",
            "!rpcs3/ppu_progs/**",
            "!rpcs3/spu_progs/**",
            "!rpcs3/savestates/**",
            "!rpcs3/screenshots/**",
            "!rpcs3/patches/**",
            "!rpcs3/games/**",
            "!rpcs3/games.yml",
            "!rpcs3/config/**/*.yml",
            "!rpcs3/config/custom_configs/**",
            "!rpcs3/GuiConfigs/*.ini",
            "!rpcs3/GuiConfigs/persistent_settings.dat",
            "!rpcs3/cache/**",
            "!lichii/user/**",
            "!ryujinx/portable/**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Uemulator",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
