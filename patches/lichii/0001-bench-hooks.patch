+    //   EDEN_BENCH_EXIT_SECONDS=<s>     close the window cleanly <s> seconds after boot
+    static bool bench_hooks_armed = false;
+    if (bench_hooks_armed) {
+        return;
+    }
+    bench_hooks_armed = true;
+    const int tas_ms = BenchEnvInt("EDEN_TAS_AUTOSTART");
+    const int record_ms = BenchEnvInt("EDEN_TAS_RECORD_AUTOSTART");
+    const int exit_seconds = BenchEnvInt("EDEN_BENCH_EXIT_SECONDS");
+    if (tas_ms >= 0 || record_ms >= 0) {
+        // The TAS engine ignores every request while this is off (it also loads script0-1.txt
+        // on its first update after it turns on, see Tas::UpdateThread).
+        Settings::values.tas_enable.SetValue(true);
+    }
+    if (tas_ms >= 0) {
+        QTimer::singleShot(tas_ms, this, [this] {
+            // StartStop() toggles: only start when stopped, never stop a running script.
+            // pause_tas_on_load has no reader anywhere, so no other state is needed.
+            if (std::get<0>(input_subsystem->GetTas()->GetStatus()) ==
+                InputCommon::TasInput::TasState::Stopped) {
+                OnTasStartStop();
+            }
+        });
+    }
+    if (record_ms >= 0) {
+        QTimer::singleShot(record_ms, this, [this] {
+            // Record() toggles: only start when not recording yet.
+            if (std::get<0>(input_subsystem->GetTas()->GetStatus()) !=
+                InputCommon::TasInput::TasState::Recording) {
+                OnTasRecord();
+            }
+        });
+    }
+    if (exit_seconds >= 0) {
+        const int exit_ms = static_cast<int>(
+            std::min<long long>(static_cast<long long>(exit_seconds) * 1000, 2'000'000'000LL));
+        QTimer::singleShot(exit_ms, this, [this] {
+            LOG_INFO(Frontend, "EDEN_BENCH_EXIT_SECONDS elapsed, closing");
+            // Skip the "are you sure" question: nobody is there to answer it. closeEvent stops
+            // the emulation and closes again, so the settings and logs flush as on a normal quit.
+            close_pending = true;
+            close();
+        });
