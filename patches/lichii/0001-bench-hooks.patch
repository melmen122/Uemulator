+namespace {
+// Benchmark hooks: a non-negative integer from the environment, or -1 when unset or invalid.
+int BenchEnvInt(const char* name) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return -1;
+    }
+    char* end = nullptr;
+    const long long parsed = std::strtoll(value, &end, 10);
+    if (end == value || *end != '\0' || parsed < 0) {
+        return -1;
+    }
+    return static_cast<int>(std::min<long long>(parsed, 2'000'000'000LL));
+}
+
+// True when EDEN_TAS_RECORD_AUTOSTART is set: the recording is then saved without a dialog.
+bool BenchTasRecordEnv() {
+    return BenchEnvInt("EDEN_TAS_RECORD_AUTOSTART") >= 0;
+}
