+#ifdef __APPLE__
+// macOS: how long a thread spins (with Pause) before it parks on a futex-style atomic wait
+// (__ulock_wait). The old instruction counts (16384 / 8192 Pause calls) are a few microseconds
+// on Apple Silicon, where `yield` is nearly free, so every short wait ended in a park + wake
+// round trip through the kernel. EDEN_NX2_SPIN_US=<us> sets the budget (default 100); 0 restores
+// the instruction-count spin. Read once.
+u32 SpinMicroseconds() {
+    static const u32 value = [] {
+        const char* const text = std::getenv("EDEN_NX2_SPIN_US");
+        if (text == nullptr || *text == '\0') {
+            return 100U;
+        }
+        char* end = nullptr;
+        const unsigned long parsed = std::strtoul(text, &end, 10);
+        return end != text && *end == '\0' ? static_cast<u32>(std::min(parsed, 1'000'000UL))
+                                            : 100U;
+    }();
+    return value;
+}
+
+/// True once a wait has spun for SpinMicroseconds() (checked every 64 calls). `spins` counts up
+/// from 0 within one wait; a smaller value than the last call starts a new wait.
+bool SpinBudgetSpent(u32 spins) {
+    thread_local u32 last_spins = ~u32{0};
+    thread_local std::chrono::steady_clock::time_point start;
+    thread_local bool spent = false;
+    if (last_spins == ~u32{0} || spins <= last_spins) {
+        start = std::chrono::steady_clock::now();
+        spent = false;
+    }
+    last_spins = spins;
+    if (!spent && (spins & 63) == 63 &&
+        std::chrono::steady_clock::now() - start >= std::chrono::microseconds{SpinMicroseconds()}) {
+        spent = true;
+    }
+    return spent;
+}
+#endif
+
