 namespace {
+// A Switch 2 title that flushes reads on demand (EDEN_NX2_PREFLUSH=0): read downloads and early
+// downloads. NativeTitle below covers the default, Preflushable pages.
 struct Nx2TitleScope {
-    Nx2TitleScope() {
+    Nx2TitleScope() : was_preflush{std::exchange(VideoCommon::g_nx2_native_preflush, false)} {
         Tegra::g_nx2_ampere = true;
     }
     ~Nx2TitleScope() {
         Tegra::g_nx2_ampere = false;
         Tegra::Nx2ClearGpuWrittenPages();
+        VideoCommon::g_nx2_native_preflush = was_preflush;
     }
+    bool was_preflush;
 };
 
 /// A dispatch that writes `value` over [address, address + size) of the buffer at 0x20000.
@@ -2238,3 +2257,164 @@ TEST_CASE("Async read-back counts the reading thread's and the GPU side's waits
     REQUIRE(counters.gpu_side_waits.load() - gpu_side_waits == 1);
     REQUIRE(f.runtime.host_read_waits == 2);
 }
+
+namespace {
+
+// Native titles read GPU-written pages that downloads keep in guest memory (Preflushable).
+struct NativeTitle {
+    NativeTitle()
+        : was_native{Tegra::g_nx2_ampere.exchange(true)},
+          was_preflush{std::exchange(VideoCommon::g_nx2_native_preflush, true)} {}
+    ~NativeTitle() {
+        Tegra::g_nx2_ampere.store(was_native);
+        VideoCommon::g_nx2_native_preflush = was_preflush;
+    }
+    bool was_native;
+    bool was_preflush;
+};
+
+} // namespace
+
+TEST_CASE("Native reads of a preflushable page never see GPU data before its download lands",
+          "[buffer_ports]") {
+    Fixture f;
+    NativeTitle native;
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    REQUIRE(f.cache->GetFlushArea(0x20010, 4)->preemtive);
+
+    // Queued for the next fence: the read flushes it.
+    std::ranges::fill(Access::Get(*f.cache, id).bytes, 0x56);
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    auto area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE_FALSE(area->preemtive);
+    REQUIRE_FALSE(area->wait_downloads);
+
+    // Downloading with a fence: the read waits for it.
+    f.cache->CommitAsyncFlushes();
+    area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE(area->preemtive);
+    REQUIRE(area->wait_downloads);
+    REQUIRE(f.cache->IsDownloadInFlight(0x20000, 0x1000));
+    REQUIRE(f.bytes[0x10010] == 0);
+
+    // The fence passes: the data is in guest memory and the read goes ahead.
+    const u64 landed = f.cache->LandedDownloads();
+    f.runtime.Finish();
+    f.cache->PopAsyncFlushes();
+    REQUIRE(f.cache->LandedDownloads() == landed + 1);
+    REQUIRE_FALSE(f.cache->IsDownloadInFlight(0x20000, 0x1000));
+    area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE(area->preemtive);
+    REQUIRE_FALSE(area->wait_downloads);
+    REQUIRE(f.bytes[0x10010] == 0x56);
+    REQUIRE(f.bytes[0x100ff] == 0x56);
+    REQUIRE(f.bytes[0x10100] == 0);
+}
+
+TEST_CASE("A GPU write over a download in flight makes native reads flush instead of wait",
+          "[buffer_ports]") {
+    Fixture f;
+    NativeTitle native;
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    f.cache->CommitAsyncFlushes();
+    REQUIRE(f.cache->GetFlushArea(0x20010, 4)->wait_downloads);
+    // The download taken holds older bytes than this write: waiting for it is not enough.
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    REQUIRE_FALSE(f.cache->IsDownloadInFlight(0x20000, 0x1000));
+    const auto area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE_FALSE(area->preemtive);
+    REQUIRE_FALSE(area->wait_downloads);
+}
+
+TEST_CASE("Other titles read preflushable pages as guest memory holds them", "[buffer_ports]") {
+    Fixture f;
+    const bool was_native = Tegra::g_nx2_ampere.exchange(false);
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    auto area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE(area->preemtive);
+    REQUIRE_FALSE(area->wait_downloads);
+    f.cache->CommitAsyncFlushes();
+    area = f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE(area->preemtive);
+    REQUIRE_FALSE(area->wait_downloads);
+    Tegra::g_nx2_ampere.store(was_native);
+}
+
+TEST_CASE("Readers waiting for downloads wake when a fence's downloads land", "[buffer_ports]") {
+    Fixture f;
+    NativeTitle native;
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    f.cache->CommitAsyncFlushes();
+    const u64 seen = f.cache->LandedDownloads();
+    std::thread fencing([&] {
+        std::this_thread::sleep_for(std::chrono::milliseconds{20});
+        f.runtime.Finish();
+        f.cache->PopAsyncFlushes();
+    });
+    const auto start = std::chrono::steady_clock::now();
+    f.cache->WaitForLandedDownloads(seen, std::chrono::seconds{10});
+    const auto waited = std::chrono::steady_clock::now() - start;
+    fencing.join();
+    REQUIRE(waited < std::chrono::seconds{5});
+    REQUIRE(f.cache->LandedDownloads() == seen + 1);
+
+    // Nothing lands: the wait ends at its timeout.
+    const auto idle_start = std::chrono::steady_clock::now();
+    f.cache->WaitForLandedDownloads(f.cache->LandedDownloads(), std::chrono::milliseconds{20});
+    const auto idle = std::chrono::steady_clock::now() - idle_start;
+    REQUIRE(idle >= std::chrono::milliseconds{15});
+    REQUIRE(idle < std::chrono::seconds{5});
+}
+
+TEST_CASE("Native GPU writes to a preflushable page arm its read trap until a read consumes it",
+          "[buffer_ports]") {
+    Fixture f;
+    NativeTitle native;
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    REQUIRE_FALSE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    // A read before the download lands must reach GetFlushArea.
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    REQUIRE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    // The read consumed the core's trap: the next write arms it again.
+    (void)f.cache->GetFlushArea(0x20010, 4);
+    REQUIRE_FALSE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    REQUIRE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    // Pages that are not Preflushable keep their own handling.
+    REQUIRE_FALSE(Access::TrapArmed(*f.cache, 0x21000, 0x1000));
+}
+
+TEST_CASE("Other titles' GPU writes to preflushable pages arm no read traps", "[buffer_ports]") {
+    Fixture f;
+    const bool was_native = Tegra::g_nx2_ampere.exchange(false);
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    Access::Preflushable(*f.cache, 0x20000, 0x1000);
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    REQUIRE_FALSE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    Tegra::g_nx2_ampere.store(was_native);
+}
+
+TEST_CASE("A native page's first read forgets its trap so the next write arms it again",
+          "[buffer_ports]") {
+    Fixture f;
+    NativeTitle native;
+    const auto id = Access::Add(*f.cache, 0x20000, 0x10000);
+    // A GPU write to a page that is not Preflushable yet arms its trap.
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    Access::ArmTrap(*f.cache, 0x20000, 0x100);
+    REQUIRE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    // The first read flushes, marks the page Preflushable and consumed the trap.
+    REQUIRE_FALSE(f.cache->GetFlushArea(0x20010, 4)->preemtive);
+    REQUIRE_FALSE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+    // The next write must reach the core again, not be skipped as still armed.
+    Access::GpuWrite(*f.cache, id, 0x20000, 0x100);
+    REQUIRE(Access::TrapArmed(*f.cache, 0x20000, 0x1000));
+}
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index dcb049da8b..32659105ee 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -334,13 +334,36 @@ std::optional<VideoCore::RasterizerDownloadArea> BufferCache<P>::GetFlushArea(DA
     DAddr device_addr_end_aligned = Common::AlignUp(device_addr + size, Core::DEVICE_PAGESIZE);
     area->start_address = device_addr_start_aligned;
     area->end_address = device_addr_end_aligned;
+    const bool native = Tegra::g_nx2_ampere.load(std::memory_order_relaxed);
+    const u64 aligned_size = device_addr_end_aligned - device_addr_start_aligned;
     if (memory_tracker.IsRegionPreflushable(device_addr, size)) {
         // Fence downloads keep it, once the first read's download is in guest memory.
         area->in_flight = std::ranges::any_of(read_downloads, [&](const ReadDownload& download) {
-            return download.write_ranges.Intersects(
-                device_addr_start_aligned, device_addr_end_aligned - device_addr_start_aligned);
+            return download.write_ranges.Intersects(device_addr_start_aligned, aligned_size);
         });
         area->preemtive = !area->in_flight;
+        // Native titles never read GPU data before it lands: a read while it is downloading with
+        // a fence waits for that fence (on the reading thread, not the GPU thread), and a read of
+        // GPU writes not committed to a fence yet flushes them. Other titles read guest memory
+        // as it is, like upstream yuzu.
+        // The core consumed this read's trap before asking: forget it, so the next GPU write
+        // arms it again instead of being skipped as still armed.
+        if (native) {
+            read_trapped_ranges.Subtract(device_addr_start_aligned, aligned_size);
+        }
+        if (native && !area->in_flight &&
+            IsRegionGpuModified(device_addr_start_aligned, aligned_size)) {
+            const auto queued = [&](const Common::RangeSet<DAddr>& ranges) {
+                return ranges.Intersects(device_addr_start_aligned, aligned_size);
+            };
+            if (queued(uncommitted_gpu_modified_ranges) ||
+                std::ranges::any_of(committed_gpu_modified_ranges, queued) ||
+                !IsDownloadInFlight(device_addr_start_aligned, aligned_size)) {
+                area->preemtive = false;
+            } else {
+                area->wait_downloads = true;
+            }
+        }
         return area;
     };
     area->preemtive = !IsRegionGpuModified(device_addr_start_aligned,
@@ -373,32 +396,25 @@ std::optional<VideoCore::RasterizerDownloadArea> BufferCache<P>::GetFlushArea(DA
     if (check_early) {
         area->preemtive = false;
     }
-    // A preflushable mark persists and downloads later GPU writes at every fence. Native titles
-    // instead keep read traps and flush on demand.
-    const bool preflush = !Tegra::g_nx2_ampere.load(std::memory_order_relaxed);
+    // A preflushable mark persists and downloads later GPU writes at every fence, so later reads
+    // find the data in guest memory or wait for its fence (above) instead of flushing.
+    // EDEN_NX2_PREFLUSH=0: native titles keep read traps and flush on demand instead
+    // (g_nx2_native_preflush).
+    const bool preflush = !native || g_nx2_native_preflush;
+    // The core consumed this read's trap before GetFlushArea (or keeps an area with no mark).
+    // Forget it either way, so the next GPU write here really arms the core again instead of
+    // being skipped by the deduplication cache, also once the read marks the page Preflushable.
+    read_trapped_ranges.Subtract(device_addr_start_aligned, aligned_size);
     if (!area->preemtive) {
         if (Nx2DownloadTrace::g_enabled) [[unlikely]] {
-            Nx2DownloadTrace::Marked(device_addr_start_aligned,
-                                     device_addr_end_aligned - device_addr_start_aligned, preflush);
+            Nx2DownloadTrace::Marked(device_addr_start_aligned, aligned_size, preflush);
         }
         if (preflush) {
-            memory_tracker.MarkRegionAsPreflushable(
-                device_addr_start_aligned, device_addr_end_aligned - device_addr_start_aligned);
-        } else {
-            if constexpr (USE_MEMORY_MAPS) {
-                cpu_read_ranges.Add(area->start_address, area->end_address - area->start_address);
-                download_cpu_read_ranges = true;
-            }
-            // The core consumed this trap before GetFlushArea. Forget it so the next GPU write
-            // really rearms the core instead of being skipped by the deduplication cache.
-            read_trapped_ranges.Subtract(
-                device_addr_start_aligned, device_addr_end_aligned - device_addr_start_aligned);
+            memory_tracker.MarkRegionAsPreflushable(device_addr_start_aligned, aligned_size);
+        } else if constexpr (USE_MEMORY_MAPS) {
+            cpu_read_ranges.Add(area->start_address, area->end_address - area->start_address);
+            download_cpu_read_ranges = true;
         }
-    } else {
-        // The core keeps this area and has no mark. The next GPU write here must arm the range
-        // again, which ends the area and sets the trap.
-        read_trapped_ranges.Subtract(device_addr_start_aligned,
-                                     device_addr_end_aligned - device_addr_start_aligned);
     }
     return area;
 }
@@ -2176,6 +2192,31 @@ void BufferCache<P>::PopAsyncBuffers() {
     async_buffers.pop_front();
     pending_downloads.pop_front();
     pending_download_ranges.pop_front();
+    {
+        std::scoped_lock lock{landed_mutex};
+        ++landed_downloads;
+    }
+    landed_cv.notify_all();
+}
+
+template <class P>
+bool BufferCache<P>::IsDownloadInFlight(DAddr addr, u64 size) const {
+    return std::ranges::any_of(pending_download_ranges,
+                               [&](const Common::RangeSet<DAddr>& ranges) {
+                                   return ranges.Intersects(addr, size);
+                               });
+}
+
+template <class P>
+u64 BufferCache<P>::LandedDownloads() {
+    std::scoped_lock lock{landed_mutex};
+    return landed_downloads;
+}
+
+template <class P>
+void BufferCache<P>::WaitForLandedDownloads(u64 seen, std::chrono::microseconds timeout) {
+    std::unique_lock lock{landed_mutex};
+    landed_cv.wait_for(lock, timeout, [&] { return landed_downloads != seen; });
 }
 
 template <class P>
