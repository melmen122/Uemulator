+    // EDEN_BENCH_SHOT_SECONDS=<s>[,<s>...]  capture a screenshot <s> seconds after boot (into the
+    // screenshots folder), so two configurations can be compared at the same replay moments.
+    if (const char* const shots = std::getenv("EDEN_BENCH_SHOT_SECONDS")) {
+        const char* cursor = shots;
+        while (*cursor != '\0') {
+            char* end = nullptr;
+            const long seconds = std::strtol(cursor, &end, 10);
+            if (end == cursor) {
+                break;
+            }
+            if (seconds >= 0 && seconds <= 100000) {
+                QTimer::singleShot(static_cast<int>(seconds * 1000), this,
+                                   [this] { OnCaptureScreenshot(); });
+            }
+            cursor = (*end == ',') ? end + 1 : end;
+        }
+    }
